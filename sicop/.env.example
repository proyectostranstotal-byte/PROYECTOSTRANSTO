# Copiar a sicop/.env y completar. NO se versiona (está en .gitignore).

# --- SICOP ---
SICOP_USER=tu_usuario@ejemplo.com
SICOP_PASS=tu_password_sicop

# --- Aviso por mail cuando un WhatsApp no se pudo enviar (cuenta de Outlook) ---
OUTLOOK_USER=tu_cuenta@outlook.com
OUTLOOK_PASS=tu_password_de_aplicacion
# Opcionales (traen default): OUTLOOK_SMTP=smtp.office365.com  OUTLOOK_PORT=587
AVISO_DESTINO=control@transtotal.com.ar
